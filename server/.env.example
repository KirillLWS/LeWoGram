# Пример переменных окружения (копировать в .env на сервере, не коммитить .env).
# SECRET_KEY — обязательна для app.config.config (подпись JWT).
# Пример: export SECRET_KEY="$(openssl rand -hex 32)"
#
# Сроки токенов (опционально; по умолчанию access 15 мин, refresh 30 дней):
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=30
#
# Пути к БД/медиа/бэкапам см. app/config/config.py (DATABASE_PATH, MEDIA_PATH, BACKUP_PATH).
#
# Push (FCM HTTP v1): опционально; без них сообщения работают, push не отправляется.
# FCM_PROJECT_ID — из консоли Firebase (Project settings).
# FCM_ACCESS_TOKEN — OAuth2 access token с правом fcm.messages.create (короткий срок жизни;
#   в проде обновляют скриптом по service account).
# FCM_PROJECT_ID=
# FCM_ACCESS_TOKEN=
#
# Версия клиента (Flutter): APK на этом же сервере (GET /releases/<имя>).
# Положите файл в server/data/releases/ или загрузите:
#   curl -H "Authorization: Bearer <jwt>" -F "file=@app-release.apk" https://host/admin/client-apk
#
# MIN_CLIENT_VERSION=0.0.2
# CLIENT_APK_FILENAME=lewo.apk
# CLIENT_UPDATE_URL=https://internal-wiki/release-notes   # опционально
